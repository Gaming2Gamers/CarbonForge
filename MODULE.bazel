module(
    name = "g2g_carbon_forge",
    version = "1.7.0",
)

bazel_dep(name = "platforms", version = "0.0.10")
bazel_dep(name = "rules_cc", version = "0.0.17")

# Upstream Google Carbon Language Toolchain (@carbon//bazel:rules.bzl)
git_repository = use_repo_rule("@bazel_tools//tools/build_defs/repo:git.bzl", "git_repository")
git_repository(
    name = "carbon",
    branch = "trunk",
    remote = "https://github.com/carbon-language/carbon-lang.git",
)
